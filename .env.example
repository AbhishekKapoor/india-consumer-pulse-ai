# ── Apify ────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here
# Actor used for Reddit scraping. Default: trudax/reddit-scraper-lite
APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite

# ── OpenRouter ───────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Two-model strategy: cheap model for classification, stronger for narrative synthesis
#
# FREE tier (zero cost — good for MVP testing):
OPENROUTER_CLASSIFICATION_MODEL=openai/gpt-4o-mini
OPENROUTER_SUMMARY_MODEL=anthropic/claude-3.5-haiku
#
# LOW COST tier (~$0.10–0.50/month — if free model quality is insufficient):
# OPENROUTER_CLASSIFICATION_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_SUMMARY_MODEL=google/gemini-flash-2.0
#
# MID TIER (best quality/cost for production):
# OPENROUTER_CLASSIFICATION_MODEL=google/gemini-flash-2.0
# OPENROUTER_SUMMARY_MODEL=anthropic/claude-haiku-3-5
#
# Fallback default if above are not set
OPENROUTER_MODEL=openrouter/auto

# ── Pipeline ─────────────────────────────────────────────────
MAX_BATCH_SIZE=10
MAX_TOKENS_CLASSIFY=1500
MAX_TOKENS_SUMMARY=2500
